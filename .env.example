# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Database
DATABASE_URL=                        # Neon DB connection string (console.neon.tech)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/boilerplate

# Auth
JWT_SECRET=                          # Any long random string (openssl rand -base64 32)

# AI
ANTHROPIC_API_KEY=                   # console.anthropic.com
AI_CREDITS_PER_MESSAGE=10            # Credits deducted per AI call

# Email (Resend)
RESEND_API_KEY=                      # resend.com -> API Keys

# File uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_ONE_TIME=price_REPLACE_ME
NEXT_PUBLIC_STRIPE_PRICE_SUBSCRIPTION=price_REPLACE_ME

# Free onboarding (links sent via email only -- never exposed on landing page)
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/your-server
NEXT_PUBLIC_DISCORD_PRO_URL=https://discord.gg/your-pro-invite   # Optional: separate invite for pro role/channel
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_DEMO_VIDEO_URL=

# Admin secret for internal test endpoints (e.g. POST /api/test/github-invite)
ADMIN_SECRET=                        # Any long random string -- keep private

# Repo links (server + client: email onboarding and SuccessStep buttons)
NEXT_PUBLIC_FREE_REPO_URL=           # Public free repo — used in email + "Use this template" button (+ /generate)
NEXT_PUBLIC_PRO_REPO_URL=            # Private pro repo — shown to pro users after invite is sent

# Pro onboarding -- GitHub API for automatic repo invites
GITHUB_TOKEN=                        # Personal access token or fine-grained token with repo collaborator write access
GITHUB_REPO_OWNER=your-org           # GitHub org or username that owns the private repo
GITHUB_REPO_NAME=your-private-pro-repo  # Private repository name to invite pro buyers into

# Pro spot limit (default 100). Set to 0 to test the Stripe paid flow locally.
TOTAL_PRO_SPOTS=100

# MCP servers (optional -- only needed if using Claude Code MCP integrations)
NEON_API_KEY=                        # console.neon.tech -> Account -> API Keys
VERCEL_TOKEN=                        # vercel.com -> Settings -> Tokens
